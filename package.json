{
  "name": "grocery-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Omnichannel Grocery Platform with Strict Domain Microservices",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" run build",
    "setup:db": "node scripts/setup-db.mjs",
    "start:backend": "node scripts/start-backend.mjs",
    "start:web": "node scripts/start-web.mjs",
    "start:all": "node scripts/start-all.mjs",
    "dev:customer": "pnpm --filter @grocery/customer-web dev",
    "dev:admin": "pnpm --filter @grocery/store-admin-web dev",
    "dev:gateway": "pnpm --filter @grocery/api-gateway dev",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "axios": "^1.21.0"
  }
}
