# ====================================================================
# Omnichannel Grocery Platform — Environment Configuration Template
# Architecture Reference: README_Grocery_Microservices_Vercel_Render_Supabase.md (Section 16)
# ====================================================================

NODE_ENV=production
LOG_LEVEL=info

# --------------------------------------------------------------------
# 1. Authoritative PostgreSQL Database (Supabase Production Pooler)
# --------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.valzvkrwugwppexzztfd:[YOUR_SUPABASE_PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.valzvkrwugwppexzztfd:[YOUR_SUPABASE_PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_POOL_MAX=20

# --------------------------------------------------------------------
# 2. Authentication & Cryptographic Tokens
# --------------------------------------------------------------------
JWT_SECRET=grocery-super-secret-jwt-key-for-development-32chars
INTERNAL_SERVICE_TOKEN=internal-grocery-mesh-secret-key-prod-999

# --------------------------------------------------------------------
# 3. Meta WhatsApp Cloud API (WhatsApp Business Platform)
# --------------------------------------------------------------------
# Official Meta WhatsApp Cloud API Permanent Access Token
WHATSAPP_ACCESS_TOKEN=EAAG...YOUR_META_PERMANENT_ACCESS_TOKEN
# WhatsApp Business Phone Number ID from Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=100000000000000
# Webhook Verification Token (shared secret entered in Meta Webhook config)
WHATSAPP_VERIFY_TOKEN=freshcart_meta_webhook_verify_token_2026
# Meta App Secret used for HMAC-SHA256 signature verification (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_hex_32chars

# --------------------------------------------------------------------
# 4. Payment Gateway (Razorpay / Stripe)
# --------------------------------------------------------------------
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_API_KEY=rzp_live_your_key_id
PAYMENT_API_SECRET=your_payment_api_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_hmac_secret
PAYMENT_CHECKOUT_BASE_URL=https://pay.groceryplatform.com/checkout

# --------------------------------------------------------------------
# 5. Microservice Routing & Internal Service Mesh URLs
# --------------------------------------------------------------------
API_GATEWAY_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3000

CATALOG_SERVICE_URL=http://localhost:3001
PRICING_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
WHATSAPP_ADAPTER_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
IDENTITY_SERVICE_URL=http://localhost:3007
FULFILLMENT_SERVICE_URL=http://localhost:3008
INVOICE_SERVICE_URL=http://localhost:3009
ANALYTICS_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011

# --------------------------------------------------------------------
# 6. Frontend Web Applications
# --------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:3000
